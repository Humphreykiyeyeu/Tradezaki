{
  "name": "tradezaki",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tradezaki/web",
    "build": "npm run build --workspace=@tradezaki/web",
    "test": "tsx --test \"packages/core/src/**/*.test.ts\"",
    "check:cloud": "node scripts/check-cloud.mjs",
    "runner": "npm start --workspace=@tradezaki/runner"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
