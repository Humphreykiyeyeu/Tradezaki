# Copy to apps/runner/.env and fill in. .env is gitignored — never commit it.

SUPABASE_URL=https://psedpaxybuikruplvqwe.supabase.co

# Supabase → Settings → API → **Secret key** (sb_secret_...).
# Formerly called "service_role". Carries BYPASSRLS and skips every row-level
# security policy, so it must never reach a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Generate ONCE with:  openssl rand -base64 32
# Decrypts every stored Deriv token. Lose it and users must reconnect;
# leak it alongside a database dump and their accounts are exposed.
DERIV_TOKEN_KEY=

DERIV_APP_ID=340ceNJpp5bdPFZLJxcew
